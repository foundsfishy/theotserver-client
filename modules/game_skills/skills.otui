SkillFirstWidget < UIWidget

SkillButton < UIButton
  height: 21
  margin-bottom: 2
  &onClick: onSkillButtonClick

SmallSkillButton < SkillButton
  height: 14

// One clickable Limit Break move slot. Deliberately NOT based on SkillButton:
// that carries &onClick: onSkillButtonClick, which would fire the row-toggle
// behaviour on top of our own handler. The digit shown is the move's SLOT
// (1..6), never its break level -- 1/3/5/7/13/25 are non-sequential internals
// with no meaning to a player, which is why !level moved to move names.
LimitBreakPip < UIButton
  height: 26
  font: verdana-11px-monochrome
  text-align: center
  text-offset: 0 -4
  border-width: 1
  &onClick: modules.game_skills.onLimitBreakPipClick

  ProgressBar
    id: fill
    height: 3
    phantom: true
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    margin-left: 2
    margin-right: 2
    margin-bottom: 2

// A framed name+value row, so the 'Next' line reads as part of the Limit Break
// control block rather than loose text under it. Based on UIButton and NOT on
// SkillButton: SkillButton's &onClick (onSkillButtonClick) only toggles a
// 'percent' child, which this row does not have -- so inheriting it would give
// a row that LOOKS pressable and does nothing. It gets a real action instead.
LimitBreakInfoButton < UIButton
  height: 17
  font: verdana-11px-monochrome
  border-width: 1
  padding-left: 3
  padding-right: 3
  &onClick: modules.game_skills.onLimitBreakNextClick

// Auto-fire mode selector (Auto / PvE / Off), mirroring !autolimit. Same visual
// vocabulary as LimitBreakPip so the whole Limit Break block reads as one
// control, but slimmer and with no fill bar -- there is nothing to fill.
LimitBreakModePip < UIButton
  height: 16
  font: verdana-11px-monochrome
  text-align: center
  border-width: 1
  &onClick: modules.game_skills.onLimitBreakModeClick

// id added 2026-07-26 so the Limit Break rows can tint their NAME label, not
// just their value (setSkillNameColor in skills.lua). Harmless for every other
// row -- they simply never look it up. Checked: nothing else in modules/
// resolves a 'name' child on a skill row.
SkillNameLabel < GameLabel
  id: name
  font: verdana-11px-monochrome
  anchors.left: parent.left
  anchors.top: parent.top
  anchors.bottom: parent.bottom

SkillValueLabel < GameLabel
  id: value
  font: verdana-11px-monochrome
  text-align: topright
  anchors.right: parent.right
  anchors.top: parent.top
  anchors.bottom: parent.bottom
  anchors.left: prev.left

SkillPercentPanel < ProgressBar
  id: percent
  background-color: green
  height: 5
  margin-top: 15
  anchors.left: parent.left
  anchors.right: parent.right
  anchors.top: parent.top
  phantom: false

MiniWindow
  id: skillWindow
  !text: tr('Skills')
  height: 150
  icon: /images/topbuttons/skills
  @onClose: modules.game_skills.onMiniWindowClose()
  &save: true
  &autoOpen: 4

  MiniWindowContents
    padding-left: 5
    padding-right: 5
    layout: verticalBox

    SkillButton
      margin-top: 5
      id: level
      SkillNameLabel
        !text: tr('Level')
      SkillValueLabel
      SkillPercentPanel
        background-color: red

    SkillButton
      id: stamina
      SkillNameLabel
        !text: tr('Stamina')
      SkillValueLabel
      SkillPercentPanel

    HorizontalSeparator
      margin-top: 2
      margin-bottom: 3

    SkillButton
      id: limitBreak
      SkillNameLabel
        !text: tr('Limit Break')
      SkillValueLabel
      SkillPercentPanel
        background-color: #FFCC00

    // Separate bar for the 90s countdown while a Break is running. Previously
    // the single bar above did both jobs, so an active Break HID the anger
    // gauge -- and the gauge keeps filling during those 90s (statchange.lua
    // still credits damage taken, it just holds the charge), so the next
    // charge building was invisible. Shown only while a Break is active.
    SkillButton
      id: limitBreakTimer
      SkillNameLabel
        !text: tr('Break time')
      SkillValueLabel
      SkillPercentPanel
        background-color: #FFCC00

    // Vertical rhythm of the Limit Break block, in reading order:
    //   [gauge bar] [break-time bar]   <- the two bars, tight together
    //   (6px)
    //   [move pips]                    <- what you pick
    //   (4px)
    //   [auto/pve/off]                 <- when it fires
    //   (6px)
    //   [Next]                         <- unlock progress
    // The gap ABOVE the pips deliberately lives on lbsPips' own margin-top, not
    // on the break-time row's margin-bottom: that row is hidden whenever no
    // Break is running, and a hidden widget contributes neither height nor
    // margin, so a gap parked there would silently collapse most of the time.
    Panel
      id: lbsPips
      height: 26
      margin-top: 6
      margin-bottom: 4
      layout:
        type: horizontalBox
        spacing: 1

    Panel
      id: lbsAuto
      height: 16
      margin-bottom: 6
      layout:
        type: horizontalBox
        spacing: 1

    LimitBreakInfoButton
      id: lbsNext
      SkillNameLabel
        !text: tr('Next')
      SkillValueLabel

    HorizontalSeparator
      id: lbsSeparatorBottom
      margin-top: 3
      margin-bottom: 3

    // Exp Boost Wallet (Mizo 2026-08-04, repositioned 2026-08-04 from under
    // Stamina to right here - top of the Experience block, since that's the
    // stat it actually affects) - a persistent character resource, other
    // reward sources besides PvP Hunt can deposit into, so it lives here as
    // a character stat rather than tucked inside one specific task's tab.
    // Bag icon born hidden - only shown once opcode 76 proves the server
    // sent wallet data (v1-era servers, or a fresh reload before the first
    // push, show nothing rather than a stuck "0/0"). EXP badge is a plain
    // Label stamped centered over the bag, not baked into a custom sprite -
    // no new art required.
    Panel
      id: expWallet
      height: 38
      margin-bottom: 2
      visible: false
      // Syntax folded in here (Mizo 2026-08-04) instead of a separate
      // always-visible hint Label below the bag - a reminder for people who
      // already know the wallet exists belongs on hover, not permanently
      // taking up a line under an icon most players glance at for a second.
      !tooltip: tr("Earn exp bonus minutes by completing Faqir's Tasks - spend them anytime with !expboost <min>.")

      // Bag (client 2853) by default; swapped to Backpack (2854) the moment
      // cap > 120 proves the shop expansion was bought - sells "it got
      // bigger" without any new art (see updateExpWallet in skills.lua).
      UIItem
        id: expWalletBag
        anchors.left: parent.left
        anchors.top: parent.top
        size: 28 28
        virtual: true

      // This engine's Label has no text-shadow/outline property, so gold
      // text alone would wash out against a light bag sprite - a small dark
      // chip behind the badge guarantees contrast regardless of sprite colors.
      Panel
        id: expWalletBadgeBg
        anchors.horizontalCenter: expWalletBag.horizontalCenter
        anchors.bottom: expWalletBag.bottom
        margin-bottom: 1
        size: 22 10
        background-color: #000000
        opacity: 0.55

      Label
        id: expWalletBadge
        anchors.horizontalCenter: expWalletBadgeBg.horizontalCenter
        anchors.verticalCenter: expWalletBadgeBg.verticalCenter
        !text: 'EXP'
        font: terminus-10px
        // White (was gold #ffe066) - Mizo 2026-08-04: matching this to the
        // website shop's badge, which now uses the same white-on-dark-chip
        // technique for real visual parity between the two surfaces.
        color: #ffffff
        text-align: center

      // margin-top 6 (Mizo 2026-08-04: "push down the numbers... just push
      // the bar and the numbers down a little bit") - was flush with the
      // bag's own top edge, which read as pinned/cramped next to a 28px
      // icon. Bag itself is untouched; only this block shifts.
      Label
        id: expWalletText
        anchors.left: expWalletBag.right
        anchors.top: expWalletBag.top
        margin-left: 8
        margin-top: 6
        font: verdana-11px-rounded
        color: white

      // Fill bar (Claude's addition, 2026-08-04) - at-a-glance fullness
      // without reading the text, same visual language as the Stamina/
      // Experience bars above. Amber rather than green/red: this isn't a
      // health-style "danger" resource, it's a "banked and ready" one.
      ProgressBar
        id: expWalletFill
        anchors.left: expWalletBag.right
        anchors.right: parent.right
        anchors.top: expWalletText.bottom
        margin-left: 8
        margin-top: 3
        height: 5
        background-color: #d9a63a
        phantom: false

    SkillButton
      id: experience
      height: 15
      SkillNameLabel
        !text: tr('Experience')
      SkillValueLabel

    SkillButton
      id: expRate
      height: 15
      SkillNameLabel
        !text: tr('Exp Rate')
      SkillValueLabel

    SkillButton
      id: xpGain
      height: 15
      SkillNameLabel
        !text: tr('Exp/Hour')
      SkillValueLabel

    SkillButton
      id: nextLevel
      height: 15
      SkillNameLabel
        !text: tr('Next Level')
      SkillValueLabel

    SkillButton
      id: kills
      height: 15
      SkillNameLabel
        !text: tr('Kills')
      SkillValueLabel

    HorizontalSeparator
      margin-top: 3
      margin-bottom: 3

    SkillButton
      id: goldPerHour
      height: 15
      SkillNameLabel
        !text: tr('Gold/Hour')
      SkillValueLabel

    HorizontalSeparator
      margin-top: 3
      margin-bottom: 3

    SkillButton
      id: health
      height: 15
      SkillNameLabel
        !text: tr('Hit Points')
      SkillValueLabel

    SkillButton
      id: mana
      height: 15
      SkillNameLabel
        !text: tr('Mana')
      SkillValueLabel

    SkillButton
      id: soul
      height: 15
      SkillNameLabel
        !text: tr('Soul Points')
      SkillValueLabel

    SkillButton
      id: capacity
      height: 15
      SkillNameLabel
        !text: tr('Capacity')
      SkillValueLabel

    SkillButton
      id: speed
      height: 15
      SkillNameLabel
        !text: tr('Speed')
      SkillValueLabel

    SkillButton
      id: regenerationTime
      SkillNameLabel
        !text: tr('Regeneration Time')
      SkillValueLabel

    SkillButton
      id: offlineTraining
      SkillNameLabel
        !text: tr('Offline Training')
      SkillValueLabel
      SkillPercentPanel

    HorizontalSeparator
      margin-top: 3
      margin-bottom: 3

    SkillButton
      id: magiclevel
      SkillNameLabel
        !text: tr('Magic Level')
      SkillValueLabel
      SkillPercentPanel
        background-color: red

    UIWidget
      height: 8
      phantom: true
      focusable: false

    SkillButton
      id: skillId1
      SkillNameLabel
        !text: tr('Club Fighting')
      SkillValueLabel
      SkillPercentPanel

    SkillButton
      id: skillId2
      SkillNameLabel
        !text: tr('Sword Fighting')
      SkillValueLabel
      SkillPercentPanel

    SkillButton
      id: skillId3
      SkillNameLabel
        !text: tr('Axe Fighting')
      SkillValueLabel
      SkillPercentPanel

    SkillButton
      id: skillId4
      SkillNameLabel
        !text: tr('Distance Fighting')
      SkillValueLabel
      SkillPercentPanel

    SkillButton
      id: skillId5
      SkillNameLabel
        !text: tr('Shielding')
      SkillValueLabel
      SkillPercentPanel

    SkillButton
      id: skillId0
      SkillNameLabel
        !text: tr('Fist Fighting')
      SkillValueLabel
      SkillPercentPanel

    SkillButton
      id: skillId6
      SkillNameLabel
        !text: tr('Fishing')
      SkillValueLabel
      SkillPercentPanel

    SmallSkillButton
      id: skillId7
      SkillNameLabel
        !text: tr('Critical Hit Chance')
      SkillValueLabel

    SmallSkillButton
      id: skillId8
      SkillNameLabel
        !text: tr('Critical Hit Damage')
      SkillValueLabel

    SmallSkillButton
      id: skillId9
      SkillNameLabel
        !text: tr('Life Leech Chance')
      SkillValueLabel

    SmallSkillButton
      id: skillId10
      SkillNameLabel
        !text: tr('Life Leech Amount')
      SkillValueLabel

    SmallSkillButton
      id: skillId11
      SkillNameLabel
        !text: tr('Mana Leech Chance')
      SkillValueLabel

    SmallSkillButton
      id: skillId12
      SkillNameLabel
        !text: tr('Mana Leech Amount')
      SkillValueLabel

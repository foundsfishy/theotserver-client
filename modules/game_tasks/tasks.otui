TasksTabBar < TabBar
TasksTabBarPanel < TabBarPanel
TasksTabBarButton < TabBarButton
  // WIDTH HERE IS IGNORED - do not tune it. UITabBar:addTab() overwrites every
  // tab's width with its own text width the moment it is created, and
  // layoutTabs() (tasks.lua) then expands them to fill the row. Only the height
  // of this size: line has any effect. Change tab sizing in layoutTabs().
  size: 60 25
  font: verdana-11px-rounded
  text-offset: 0 2

  $!first:
    anchors.left: prev.right
    margin-left: 4

  $hover !checked:
    color: #ffffff

  $checked:
    color: #ffffff
    image-color: #EF9F27

TaskButton < Button
  height: 21
  font: verdana-11px-rounded

// Themed to match WishBanner's own palette (background #2a1e08, border/label
// #EF9F27/#FAC775) so its Accept button reads as part of that banner rather
// than a generic grey button dropped on top of it.
WishAcceptButton < TaskButton
  image-color: #EF9F27
  color: white

  $hover !disabled:
    image-color: #FAC775

  $pressed:
    image-color: #c97f1c

OfferSlot < Panel
  height: 90
  background-color: #1a1a1a
  border-width: 1
  border-color: #4a453e
  padding: 6
  margin-bottom: 4

  // Three columns: sprite (left) | text (middle) | stacked buttons (right).
  // The buttons used to sit along the bottom edge and overlapped the taller
  // sprite; moving them into their own right-hand column frees the full slot
  // height for the creature and lets the text breathe between them.
  // margin-top compensates for the engine drawing the outfit low inside the
  // widget rect (creatures are drawn standing, so a sprite smaller than the
  // 64x64 box leaves its empty space at the TOP and reads as sitting low).
  UICreature
    id: creature
    phantom: true
    size: 64 64
    anchors.verticalCenter: parent.verticalCenter
    anchors.left: parent.left
    margin-top: -6
    margin-left: 13

  // The "^ MOVED UP" indicator lives on the accept button itself now (see
  // fillOffers/flashActiveOffer in tasks.lua) rather than a separate corner
  // badge - ASCII only, this client's font atlases have no real arrow glyph
  // and player-facing text stays ASCII project-wide, so a caret stands in
  // for an up-arrow rather than a unicode triangle that could render blank.

  TaskButton
    id: accept
    !text: tr('Accept')
    width: 84
    anchors.bottom: parent.verticalCenter
    margin-bottom: 3
    anchors.right: parent.right

  TaskButton
    id: reroll
    !text: tr('Reroll')
    width: 84
    anchors.top: parent.verticalCenter
    margin-top: 3
    anchors.right: parent.right

  Label
    id: name
    font: verdana-11px-rounded
    anchors.bottom: parent.verticalCenter
    anchors.left: creature.right
    anchors.right: accept.left
    margin-left: 18
    margin-right: 8
    margin-bottom: 2
    text: -

  Label
    id: info
    font: verdana-11px-rounded
    color: #aaaaaa
    anchors.top: parent.verticalCenter
    anchors.left: creature.right
    anchors.right: reroll.left
    margin-left: 18
    margin-right: 8
    margin-top: 1
    text: -

WishBanner < Panel
  height: 40
  background-color: #2a1e08
  border-width: 1
  border-color: #EF9F27
  padding: 6
  margin-bottom: 14

  Label
    id: label
    font: verdana-11px-rounded
    color: #FAC775
    width: 260
    anchors.top: parent.top
    anchors.left: parent.left
    text: -

  Label
    id: name
    font: verdana-11px-rounded
    width: 260
    anchors.top: prev.bottom
    anchors.left: parent.left
    text: -

  WishAcceptButton
    id: accept
    !text: tr('Accept')
    width: 70
    anchors.verticalCenter: parent.verticalCenter
    anchors.right: parent.right

TasksOffersPanel < Panel
  padding-top: 8

  // Shuffle is a FIXED footer, deliberately outside the ScrollablePanel. As the
  // last child of the scrolling list it only appeared after scrolling past all
  // five offers - an action that applies to the whole list should never be
  // something you have to go looking for.
  TaskButton
    id: shuffle
    !text: tr('Shuffle all - 150K gold')
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    anchors.right: parent.right

  ScrollablePanel
    id: offersScroll
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: shuffle.top
    margin-right: 16
    margin-bottom: 8
    vertical-scrollbar: offersScrollBar
    layout: verticalBox

    WishBanner
      id: wishBanner

    OfferSlot
      id: slot1
    OfferSlot
      id: slot2
    OfferSlot
      id: slot3
    OfferSlot
      id: slot4
    OfferSlot
      id: slot5

  VerticalScrollBar
    id: offersScrollBar
    anchors.top: offersScroll.top
    anchors.bottom: offersScroll.bottom
    anchors.right: parent.right
    step: 14
    pixels-scroll: true

// One running task = one card. A v1 server fills exactly one of these; a v2
// server fills up to three (its slots field caps it). Cards are CREATED
// per-fill in fillActive rather than declared here - dynamic creation means
// an empty list simply has no children, so there are no hidden-widget gaps
// inside the verticalBox to manage. Same card look as OfferSlot (fill,
// border, padding, 64x64 sprite left), but the progress bar moves INSIDE
// along the bottom edge: with up to three cards stacked there is no single
// "under the card" spot for a shared full-width bar anymore.
// 108 rather than a rounder 112: the tab content area under the tab bar is
// 369px, and three stacked cards (max slots) plus the wallet readout must
// fit it with slack - 3*(108+6) + wallet line = ~356.
ActiveTaskCard < Panel
  height: 108
  background-color: #1a1a1a
  border-width: 1
  border-color: #4a453e
  padding: 6
  margin-bottom: 6

  ProgressBar
    id: progress
    background-color: #639922
    height: 14
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    phantom: false

  UICreature
    id: creature
    phantom: true
    size: 64 64
    anchors.top: parent.top
    anchors.left: parent.left
    margin-top: 8
    margin-left: 13

  TaskButton
    id: drop
    !text: tr('Drop Task')
    width: 84
    anchors.top: parent.top
    margin-top: 30
    anchors.right: parent.right

  Label
    id: name
    font: verdana-11px-rounded
    anchors.top: parent.top
    margin-top: 16
    anchors.left: creature.right
    anchors.right: drop.left
    margin-left: 18
    margin-right: 8
    text: No active task

  Label
    id: progressText
    font: verdana-11px-monochrome
    color: #dfdfdf
    text-wrap: true
    multi-line: true
    height: 30
    anchors.top: prev.bottom
    margin-top: 4
    anchors.left: creature.right
    anchors.right: drop.left
    margin-left: 18
    margin-right: 8
    text: -

TasksActivePanel < Panel
  padding-top: 8

  Panel
    id: activeList
    layout: verticalBox
    fit-children: true
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right

  // v2-only chrome, both born hidden and only shown once a v2 payload proves
  // the server carries their data (wallet / shopoffer fields). Anchored to the
  // panel BOTTOM rather than under activeList so their position never depends
  // on how many cards exist above them. walletLabel is the anchor base for
  // unlockSlots even while invisible - invisible widgets keep their rect in
  // this engine, so the chain stays stable whichever of the two is shown.
  Label
    id: walletLabel
    font: verdana-11px-monochrome
    color: #FAC775
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    visible: false
    text: -

  // WishAcceptButton, not a plain TaskButton: the gold treatment is the
  // window's existing "this one is special" accent (the Wish banner), and
  // this is the one button that leads to the shop.
  WishAcceptButton
    id: unlockSlots
    !text: tr('Unlock extra slots?')
    !tooltip: tr('Buy an extra task slot in the website shop')
    anchors.bottom: walletLabel.top
    margin-bottom: 6
    anchors.left: parent.left
    anchors.right: parent.right
    visible: false

  // Empty-state only: with no running tasks the card list has no children
  // (see fillActive) and this big Faqir + speech bubble fills the space
  // instead, rather than a small placeholder line in a dead card. No dedicated speech-bubble art exists in
  // this client (checked - nothing under data/images), so the bubble is a
  // plain WishBanner-style panel above his head, not a pointed-tail shape.
  Panel
    id: faqirBubble
    width: 280
    height: 50
    background-color: #2a1e08
    border-width: 1
    border-color: #EF9F27
    padding: 8
    anchors.bottom: faqirCreature.top
    margin-bottom: 6
    anchors.horizontalCenter: parent.horizontalCenter

    Label
      id: faqirBubbleTitle
      font: verdana-11px-rounded
      color: #FAC775
      width: 264
      height: 14
      anchors.top: parent.top
      anchors.left: parent.left
      text: -

    Label
      id: faqirBubbleText
      font: verdana-11px-monochrome
      color: #dfdfdf
      text-wrap: true
      multi-line: true
      width: 264
      height: 26
      anchors.top: prev.bottom
      anchors.left: parent.left
      text: -

  UICreature
    id: faqirCreature
    phantom: true
    size: 128 128
    anchors.verticalCenter: parent.verticalCenter
    margin-top: 11
    anchors.horizontalCenter: parent.horizontalCenter


// This client has NO text-outline property (checked every .otui + style file),
// so readability against the list's mid-grey background comes from a heavier
// antialiased font plus the brightened CATALOG_TIER_COLOR palette in tasks.lua
// - the Offers-tab tier colors are tuned for a near-black panel and go muddy
// here. Row height is up from 18 to give the taller font room to breathe.
TaskCatalogEntry < Label
  height: 20
  focusable: true
  font: verdana-11px-antialised
  color: #dfdfdf
  text-offset: 4 3
  background-color: alpha

  // Deliberately NO color override here - each row's tier color is applied
  // per-row via setColor() in fillCatalog, and a color: in this state block
  // would win over it, flattening every tier to one shade on selection.
  // Only the background changes to show focus.
  $focus:
    background-color: #4a453e

  $!focus:
    background-color: alpha

TasksCatalogPanel < Panel
  padding-top: 8

  Label
    id: searchLabel
    font: verdana-11px-monochrome
    color: #dfdfdf
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    text: Search by name or id

  Label
    id: searchHint
    font: verdana-11px-monochrome
    color: #dfdfdf
    anchors.top: prev.bottom
    margin-top: 3
    anchors.left: parent.left
    anchors.right: parent.right
    text: Type below to search all tasks by name or id.

  TextEdit
    id: search
    !tooltip: tr('Search tasks by monster name, task name or task id')
    placeholder: Start typing a monster name or task id...
    placeholder-color: #FFD700
    anchors.top: prev.bottom
    margin-top: 16
    anchors.left: parent.left
    anchors.right: parent.right

  TextList
    id: catalogList
    anchors.top: prev.bottom
    margin-top: 12
    anchors.left: parent.left
    anchors.right: parent.right
    height: 240
    focusable: false
    vertical-scrollbar: catalogListScrollBar

  VerticalScrollBar
    id: catalogListScrollBar
    anchors.top: catalogList.top
    anchors.bottom: catalogList.bottom
    anchors.right: catalogList.right
    step: 14
    pixels-scroll: true

  TaskButton
    id: chooseBtn
    !text: tr('Hand-pick selected task')
    anchors.top: catalogList.bottom
    margin-top: 12
    anchors.left: parent.left
    anchors.right: parent.right

TasksHuntPanel < Panel
  padding-top: 8

  Label
    id: huntStatus
    font: verdana-11px-rounded
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    text-wrap: true
    text: -

  ProgressBar
    id: huntProgress
    background-color: #E24B4A
    height: 16
    anchors.top: prev.bottom
    margin-top: 10
    anchors.left: parent.left
    anchors.right: parent.right
    phantom: false

  TaskButton
    id: huntAccept
    !text: tr('Accept hunt')
    anchors.top: prev.bottom
    margin-top: 10
    anchors.left: parent.left
    width: 110

  TaskButton
    id: huntDrop
    !text: tr('Drop hunt')
    anchors.top: prev.top
    anchors.left: prev.right
    margin-left: 6
    width: 110

TasksProgressPanel < Panel
  padding-top: 8

  Label
    id: streakLabel
    font: verdana-11px-monochrome
    color: #dfdfdf
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    text: Streak

  // streakRow (26px) and passRow (8px) removed 2026-07-29: both were empty
  // panels no Lua ever populated - placeholders for the unbuilt day-pip /
  // season-segment widgets - so they rendered as invisible dead gaps and were
  // the source of the tab's uneven spacing. Re-add them WITH their fill code,
  // not before it.

  Label
    id: weeklyLabel
    font: verdana-11px-monochrome
    color: #dfdfdf
    anchors.top: prev.bottom
    margin-top: 12
    anchors.left: parent.left
    anchors.right: parent.right
    text: Weekly challenge

  ProgressBar
    id: weeklyProgress
    background-color: #378ADD
    height: 16
    anchors.top: prev.bottom
    margin-top: 4
    anchors.left: parent.left
    anchors.right: parent.right
    phantom: false

  Label
    id: passLabel
    font: verdana-11px-monochrome
    color: #dfdfdf
    anchors.top: prev.bottom
    margin-top: 12
    anchors.left: parent.left
    anchors.right: parent.right
    text: Season pass

  Label
    id: rankingsLabel
    font: verdana-11px-monochrome
    color: #dfdfdf
    anchors.top: prev.bottom
    margin-top: 12
    anchors.left: parent.left
    anchors.right: parent.right
    text: Top killers / rankings

  TextList
    id: rankingsList
    anchors.top: prev.bottom
    margin-top: 4
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    focusable: false

OddsRow < Panel
  height: 30
  margin-bottom: 4

  Label
    id: tierLabel
    font: verdana-11px-rounded
    width: 50
    anchors.top: parent.top
    anchors.left: parent.left
    text: -

  Label
    id: rewardText
    font: verdana-11px-rounded
    color: #aaaaaa
    anchors.top: parent.top
    anchors.left: prev.right
    anchors.right: parent.right
    margin-left: 10
    text: -

  ProgressBar
    id: sigilBar
    background-color: #EF9F27
    height: 16
    anchors.top: prev.bottom
    margin-top: 3
    anchors.left: parent.left
    anchors.right: parent.right
    phantom: false

TasksOddsPanel < Panel
  padding-top: 8
  layout: verticalBox

  OddsRow
    id: oddsRow1
  OddsRow
    id: oddsRow2
  OddsRow
    id: oddsRow3
  OddsRow
    id: oddsRow4
  OddsRow
    id: oddsRow5

// ===== Marks tab (Faqir's Dagger, v2 only - the tab itself is only added
// once a v2 payload arrives, so v1 sessions never see any of this) =====

// terminus-10px is the ONLY fixed-glyph-width font in data/fonts
// (fixed-glyph-width: 6) - the kris contract art is column-aligned ASCII and
// falls apart in any proportional face. Height matches the font's declared
// 12px exactly (terminus-10px.otfont says height: 12 - anything tighter
// clips the bottom glyph row) so the art lines butt together and read as
// one drawing instead of a spaced-out list.
MarksLine < Label
  font: terminus-10px
  height: 12
  color: #d8c8a0

MarksHeader < Label
  font: verdana-11px-rounded
  height: 18
  margin-top: 8
  margin-bottom: 2

MarksText < Label
  font: verdana-11px-rounded
  color: #aaaaaa
  text-wrap: true
  multi-line: true
  height: 30
  margin-bottom: 2

MarksDaggerRow < Panel
  height: 36
  margin-bottom: 2

  UICreature
    id: creature
    phantom: true
    size: 32 32
    anchors.verticalCenter: parent.verticalCenter
    anchors.left: parent.left
    margin-left: 6

  Label
    id: name
    font: verdana-11px-rounded
    color: #FF6666
    anchors.verticalCenter: parent.verticalCenter
    anchors.left: creature.right
    anchors.right: parent.right
    margin-left: 12

// The wanted poster (Mizo): the prey's ACTUAL character outfit rendered via
// UICreature - same technique OfferSlot uses for monster outfits and
// fillActive's Faqir materialize - with the header above and name+level in
// contract green beside it.
MarksPoster < Panel
  height: 112
  background-color: #1a1a1a
  border-width: 1
  border-color: #2e5c2e
  padding: 6
  margin-bottom: 4

  UICreature
    id: creature
    phantom: true
    size: 64 64
    anchors.verticalCenter: parent.verticalCenter
    anchors.left: parent.left
    margin-top: -6
    margin-left: 13

  // sans-bold-16px (20px tall) rather than the window's verdana-11px: this
  // line IS the poster - it should shout the way a real wanted bill does,
  // and it's the only place in the window that earns display type.
  Label
    id: wantedHeader
    font: sans-bold-16px
    color: #E24B4A
    height: 20
    anchors.top: parent.top
    margin-top: 8
    anchors.left: creature.right
    anchors.right: parent.right
    margin-left: 18
    text: WANTED - DEAD

  Label
    id: preyName
    font: verdana-11px-rounded
    color: #66CC66
    anchors.top: prev.bottom
    margin-top: 8
    anchors.left: creature.right
    anchors.right: parent.right
    margin-left: 18
    text: -

  Label
    id: badge
    font: verdana-11px-rounded
    color: #FFD700
    anchors.top: prev.bottom
    margin-top: 6
    anchors.left: creature.right
    anchors.right: parent.right
    margin-left: 18
    visible: false
    text: Two daggers, one grave.

TasksMarksPanel < Panel
  padding-top: 8

  // Fixed footer outside the scroll, same reasoning as the Offers tab's
  // Shuffle: a whole-tab action should never need scrolling to find.
  TaskButton
    id: bladesBoard
    !text: tr('The Blades Board')
    !tooltip: tr('Open The Blades Board on the website')
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    anchors.right: parent.right

  ScrollablePanel
    id: marksScroll
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: bladesBoard.top
    margin-right: 16
    margin-bottom: 8
    vertical-scrollbar: marksScrollBar
    layout: verticalBox

  VerticalScrollBar
    id: marksScrollBar
    anchors.top: marksScroll.top
    anchors.bottom: marksScroll.bottom
    anchors.right: parent.right
    step: 14
    pixels-scroll: true

TasksWindow < MainWindow
  id: tasksWindow
  !text: tr("Faqir's Tasks")
  size: 420 460

  @onEscape: modules.game_tasks.toggle()

  TasksTabBar
    id: tasksTabBar
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    height: 25

  Panel
    id: tasksTabContent
    anchors.top: prev.bottom
    margin-top: 6
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: parent.bottom

TasksTabBar < TabBar
TasksTabBarPanel < TabBarPanel
TasksTabBarButton < TabBarButton
  // WIDTH HERE IS IGNORED - do not tune it. UITabBar:addTab() overwrites every
  // tab's width with its own text width the moment it is created, and
  // layoutTabs() (tasks.lua) then expands them to fill the row. Only the height
  // of this size: line has any effect. Change tab sizing in layoutTabs().
  size: 60 25
  font: verdana-11px-rounded
  text-offset: 0 2

  $!first:
    anchors.left: prev.right
    margin-left: 4

  $hover !checked:
    color: #ffffff

  $checked:
    color: #ffffff
    image-color: #EF9F27

TaskButton < Button
  height: 21
  font: verdana-11px-rounded

// Themed to match WishBanner's own palette (background #2a1e08, border/label
// #EF9F27/#FAC775) so its Accept button reads as part of that banner rather
// than a generic grey button dropped on top of it.
WishAcceptButton < TaskButton
  image-color: #EF9F27
  color: white

  $hover !disabled:
    image-color: #FAC775

  $pressed:
    image-color: #c97f1c

OfferSlot < Panel
  height: 90
  background-color: #1a1a1a
  border-width: 1
  border-color: #4a453e
  padding: 6
  margin-bottom: 4

  // Three columns: sprite (left) | text (middle) | stacked buttons (right).
  // The buttons used to sit along the bottom edge and overlapped the taller
  // sprite; moving them into their own right-hand column frees the full slot
  // height for the creature and lets the text breathe between them.
  // margin-top compensates for the engine drawing the outfit low inside the
  // widget rect (creatures are drawn standing, so a sprite smaller than the
  // 64x64 box leaves its empty space at the TOP and reads as sitting low).
  UICreature
    id: creature
    phantom: true
    size: 64 64
    anchors.verticalCenter: parent.verticalCenter
    anchors.left: parent.left
    margin-top: -6
    margin-left: 13

  TaskButton
    id: accept
    !text: tr('Accept')
    width: 84
    anchors.bottom: parent.verticalCenter
    margin-bottom: 3
    anchors.right: parent.right

  TaskButton
    id: reroll
    !text: tr('Reroll')
    width: 84
    anchors.top: parent.verticalCenter
    margin-top: 3
    anchors.right: parent.right

  Label
    id: name
    font: verdana-11px-rounded
    anchors.bottom: parent.verticalCenter
    anchors.left: creature.right
    anchors.right: accept.left
    margin-left: 18
    margin-right: 8
    margin-bottom: 2
    text: -

  Label
    id: info
    font: verdana-11px-rounded
    color: #aaaaaa
    anchors.top: parent.verticalCenter
    anchors.left: creature.right
    anchors.right: reroll.left
    margin-left: 18
    margin-right: 8
    margin-top: 1
    text: -

WishBanner < Panel
  height: 40
  background-color: #2a1e08
  border-width: 1
  border-color: #EF9F27
  padding: 6
  margin-bottom: 14

  Label
    id: label
    font: verdana-11px-rounded
    color: #FAC775
    width: 260
    anchors.top: parent.top
    anchors.left: parent.left
    text: -

  Label
    id: name
    font: verdana-11px-rounded
    width: 260
    anchors.top: prev.bottom
    anchors.left: parent.left
    text: -

  WishAcceptButton
    id: accept
    !text: tr('Accept')
    width: 70
    anchors.verticalCenter: parent.verticalCenter
    anchors.right: parent.right

TasksOffersPanel < Panel
  padding-top: 8

  // Shuffle is a FIXED footer, deliberately outside the ScrollablePanel. As the
  // last child of the scrolling list it only appeared after scrolling past all
  // five offers - an action that applies to the whole list should never be
  // something you have to go looking for.
  TaskButton
    id: shuffle
    !text: tr('Shuffle all - 150K gold')
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    anchors.right: parent.right

  ScrollablePanel
    id: offersScroll
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: shuffle.top
    margin-right: 16
    margin-bottom: 8
    vertical-scrollbar: offersScrollBar
    layout: verticalBox

    WishBanner
      id: wishBanner

    OfferSlot
      id: slot1
    OfferSlot
      id: slot2
    OfferSlot
      id: slot3
    OfferSlot
      id: slot4
    OfferSlot
      id: slot5

  VerticalScrollBar
    id: offersScrollBar
    anchors.top: offersScroll.top
    anchors.bottom: offersScroll.bottom
    anchors.right: parent.right
    step: 14
    pixels-scroll: true

TasksActivePanel < Panel
  padding-top: 8

  // Card is a straight mirror of OfferSlot: same height/fill/border/padding,
  // 64x64 unframed sprite left with the same -6 draw-offset compensation, the
  // two text lines straddling the vertical midline with the same 18/8 side
  // margins and 2/1 midline gap, action button right on the midline.
  Panel
    id: activeCard
    height: 90
    background-color: #1a1a1a
    border-width: 1
    border-color: #4a453e
    padding: 6
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right

    UICreature
      id: creature
      phantom: true
      size: 64 64
      anchors.verticalCenter: parent.verticalCenter
      anchors.left: parent.left
      margin-top: -6
      margin-left: 13

    TaskButton
      id: drop
      !text: tr('Drop Task')
      width: 84
      anchors.verticalCenter: parent.verticalCenter
      anchors.right: parent.right
      margin-right: 24

    Label
      id: name
      font: verdana-11px-rounded
      anchors.bottom: parent.verticalCenter
      anchors.left: creature.right
      anchors.right: drop.left
      margin-left: 18
      margin-right: 8
      margin-bottom: 2
      text: No active task

    Label
      id: progressText
      font: verdana-11px-monochrome
      color: #dfdfdf
      text-wrap: true
      multi-line: true
      height: 30
      anchors.top: parent.verticalCenter
      anchors.left: creature.right
      anchors.right: drop.left
      margin-left: 18
      margin-right: 8
      margin-top: 1
      text: -

  // Full width UNDER the card, not inside it - inside, it had to squeeze into
  // the middle column between sprite and button, which fought the two-line
  // centering the offers layout is built on.
  ProgressBar
    id: progress
    background-color: #639922
    height: 16
    anchors.top: prev.bottom
    margin-top: 10
    anchors.left: parent.left
    anchors.right: parent.right
    phantom: false

  // Empty-state only: activeCard hides entirely (see fillActive) and this
  // big Faqir + speech bubble fills the space instead, rather than a small
  // placeholder line in the card. No dedicated speech-bubble art exists in
  // this client (checked - nothing under data/images), so the bubble is a
  // plain WishBanner-style panel above his head, not a pointed-tail shape.
  Panel
    id: faqirBubble
    width: 280
    height: 50
    background-color: #2a1e08
    border-width: 1
    border-color: #EF9F27
    padding: 8
    anchors.bottom: faqirCreature.top
    margin-bottom: 6
    anchors.horizontalCenter: parent.horizontalCenter

    Label
      id: faqirBubbleTitle
      font: verdana-11px-rounded
      color: #FAC775
      width: 264
      height: 14
      anchors.top: parent.top
      anchors.left: parent.left
      text: -

    Label
      id: faqirBubbleText
      font: verdana-11px-monochrome
      color: #dfdfdf
      text-wrap: true
      multi-line: true
      width: 264
      height: 26
      anchors.top: prev.bottom
      anchors.left: parent.left
      text: -

  UICreature
    id: faqirCreature
    phantom: true
    size: 128 128
    anchors.verticalCenter: parent.verticalCenter
    margin-top: 11
    anchors.horizontalCenter: parent.horizontalCenter


// This client has NO text-outline property (checked every .otui + style file),
// so readability against the list's mid-grey background comes from a heavier
// antialiased font plus the brightened CATALOG_TIER_COLOR palette in tasks.lua
// - the Offers-tab tier colors are tuned for a near-black panel and go muddy
// here. Row height is up from 18 to give the taller font room to breathe.
TaskCatalogEntry < Label
  height: 20
  focusable: true
  font: verdana-11px-antialised
  color: #dfdfdf
  text-offset: 4 3
  background-color: alpha

  // Deliberately NO color override here - each row's tier color is applied
  // per-row via setColor() in fillCatalog, and a color: in this state block
  // would win over it, flattening every tier to one shade on selection.
  // Only the background changes to show focus.
  $focus:
    background-color: #4a453e

  $!focus:
    background-color: alpha

TasksCatalogPanel < Panel
  padding-top: 8

  Label
    id: searchLabel
    font: verdana-11px-monochrome
    color: #dfdfdf
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    text: Search by name or id

  Label
    id: searchHint
    font: verdana-11px-monochrome
    color: #dfdfdf
    anchors.top: prev.bottom
    margin-top: 3
    anchors.left: parent.left
    anchors.right: parent.right
    text: Type below to search all tasks by name or id.

  TextEdit
    id: search
    !tooltip: tr('Search tasks by monster name, task name or task id')
    placeholder: Start typing a monster name or task id...
    placeholder-color: #FFD700
    anchors.top: prev.bottom
    margin-top: 16
    anchors.left: parent.left
    anchors.right: parent.right

  TextList
    id: catalogList
    anchors.top: prev.bottom
    margin-top: 12
    anchors.left: parent.left
    anchors.right: parent.right
    height: 240
    focusable: false
    vertical-scrollbar: catalogListScrollBar

  VerticalScrollBar
    id: catalogListScrollBar
    anchors.top: catalogList.top
    anchors.bottom: catalogList.bottom
    anchors.right: catalogList.right
    step: 14
    pixels-scroll: true

  TaskButton
    id: chooseBtn
    !text: tr('Hand-pick selected task')
    anchors.top: catalogList.bottom
    margin-top: 12
    anchors.left: parent.left
    anchors.right: parent.right

TasksHuntPanel < Panel
  padding-top: 8

  Label
    id: huntStatus
    font: verdana-11px-rounded
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    text-wrap: true
    text: -

  ProgressBar
    id: huntProgress
    background-color: #E24B4A
    height: 16
    anchors.top: prev.bottom
    margin-top: 10
    anchors.left: parent.left
    anchors.right: parent.right
    phantom: false

  TaskButton
    id: huntAccept
    !text: tr('Accept hunt')
    anchors.top: prev.bottom
    margin-top: 10
    anchors.left: parent.left
    width: 110

  TaskButton
    id: huntDrop
    !text: tr('Drop hunt')
    anchors.top: prev.top
    anchors.left: prev.right
    margin-left: 6
    width: 110

TasksProgressPanel < Panel
  padding-top: 8

  Label
    id: streakLabel
    font: verdana-11px-monochrome
    color: #dfdfdf
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    text: Streak

  // streakRow (26px) and passRow (8px) removed 2026-07-29: both were empty
  // panels no Lua ever populated - placeholders for the unbuilt day-pip /
  // season-segment widgets - so they rendered as invisible dead gaps and were
  // the source of the tab's uneven spacing. Re-add them WITH their fill code,
  // not before it.

  Label
    id: weeklyLabel
    font: verdana-11px-monochrome
    color: #dfdfdf
    anchors.top: prev.bottom
    margin-top: 12
    anchors.left: parent.left
    anchors.right: parent.right
    text: Weekly challenge

  ProgressBar
    id: weeklyProgress
    background-color: #378ADD
    height: 16
    anchors.top: prev.bottom
    margin-top: 4
    anchors.left: parent.left
    anchors.right: parent.right
    phantom: false

  Label
    id: passLabel
    font: verdana-11px-monochrome
    color: #dfdfdf
    anchors.top: prev.bottom
    margin-top: 12
    anchors.left: parent.left
    anchors.right: parent.right
    text: Season pass

  Label
    id: rankingsLabel
    font: verdana-11px-monochrome
    color: #dfdfdf
    anchors.top: prev.bottom
    margin-top: 12
    anchors.left: parent.left
    anchors.right: parent.right
    text: Top killers / rankings

  TextList
    id: rankingsList
    anchors.top: prev.bottom
    margin-top: 4
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    focusable: false

OddsRow < Panel
  height: 30
  margin-bottom: 4

  Label
    id: tierLabel
    font: verdana-11px-rounded
    width: 50
    anchors.top: parent.top
    anchors.left: parent.left
    text: -

  Label
    id: rewardText
    font: verdana-11px-rounded
    color: #aaaaaa
    anchors.top: parent.top
    anchors.left: prev.right
    anchors.right: parent.right
    margin-left: 10
    text: -

  ProgressBar
    id: sigilBar
    background-color: #EF9F27
    height: 16
    anchors.top: prev.bottom
    margin-top: 3
    anchors.left: parent.left
    anchors.right: parent.right
    phantom: false

TasksOddsPanel < Panel
  padding-top: 8
  layout: verticalBox

  OddsRow
    id: oddsRow1
  OddsRow
    id: oddsRow2
  OddsRow
    id: oddsRow3
  OddsRow
    id: oddsRow4
  OddsRow
    id: oddsRow5

TasksWindow < MainWindow
  id: tasksWindow
  !text: tr("Faqir's Tasks")
  size: 420 460

  @onEscape: modules.game_tasks.toggle()

  TasksTabBar
    id: tasksTabBar
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    height: 25

  Panel
    id: tasksTabContent
    anchors.top: prev.bottom
    margin-top: 6
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: parent.bottom
